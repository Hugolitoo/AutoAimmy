<UserControl x:Class="Aimmy2.Controls.AutoAimmyMenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6FFFFFF"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF362A52"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="DashboardScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,14,22,20">
            <DockPanel Margin="0,0,0,12">
                <TextBlock x:Name="VersionText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#AC9AD5"/>
                <TextBlock Text="AutoAimmy" FontSize="24" FontWeight="Bold"/>
            </DockPanel>
            <Border Background="#1829BA86" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="ObservationTitle" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ObservationDetail" Margin="0,5,0,0"/>
                    <TextBlock x:Name="ModelText" Foreground="#BFFFFFFF" Margin="0,6,0,0"/>
                    <TextBlock x:Name="OutputModeText" Text="Mode observation : l’assistance ne déplace pas la souris." Foreground="#BFFFFFFF" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#2229BA86" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Session locale · calibration et assistance" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="1. Chargez un modèle. 2. Démarrez la session. 3. Calibrez devant une cible immobile, sans marcher ni tirer, dans la vue que vous utiliserez. 4. Activez l’assistance." Margin="0,6,0,6"/>
                    <TextBlock x:Name="LocalStatusText" Foreground="#E6D8B3"/>
                    <TextBlock x:Name="LocalProfileText" Margin="0,6,0,0"/>
                    <TextBlock x:Name="LocalCaptureText" Margin="0,6,0,0"/>
                    <TextBlock Text="Enregistrement local à 5 images/s, avec lecture animée. Maximum 512 Mo par session / 2 Go au total, puis arrêt de la collecte. Aucun envoi. Les profils utilisent la taille et la vitesse à l’écran, pas des mètres." Foreground="#BFFFFFFF" Margin="0,6,0,0"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="StartLocalButton" Content="Démarrer la session locale" Click="StartLocal_Click"/>
                        <Button x:Name="CalibrateLocalButton" Content="Calibration guidée (45 s max)" Click="CalibrateLocal_Click"/>
                        <Button x:Name="AssistLocalButton" Content="Activer l’assistance expérimentale" Click="AssistLocal_Click"/>
                        <Button x:Name="StopLocalButton" Content="Arrêter la session" Click="StopLocal_Click"/>
                        <Button Content="Voir les enregistrements" Click="OpenRecordings_Click"/>
                    </WrapPanel>
                    <TextBlock Text="L’assistance fonctionne avec votre touche de visée maintenue. F8 l’arrête. Recalibrez après un changement de DPI, zoom ou sensibilité. La calibration n’identifie pas automatiquement ces changements." Foreground="#E6D8B3"/>
                </StackPanel>
            </Border>
            <Border Background="#14FFFFFF" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Amélioration du détecteur sur ce PC" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LearningStatusText" Margin="0,6,0,0"/>
                    <TextBlock Text="Les détections stables et les cas difficiles sont conservés. Vérifiez les exemples ici ; l’application peut ensuite comparer automatiquement les seuils et les modèles sur des sessions séparées. Les cadres proposés ne sont pas une vérité terrain." Foreground="#BFFFFFFF" Margin="0,6,0,0"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="ReviewLearningButton" Content="Vérifier les images" Click="ReviewLearning_Click"/>
                        <Button x:Name="OptimizeLearningButton" Content="Optimiser la détection locale" Click="OptimizeLearning_Click"/>
                        <Button x:Name="CompareModelButton" Content="Comparer un modèle ONNX" Click="CompareModel_Click"/>
                        <Button x:Name="RollbackModelButton" Content="Revenir au modèle précédent" Click="RollbackModel_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="LearningActionText" Foreground="#E6D8B3"/>
                    <TextBlock Text="Le réentraînement des poids demande un modèle source entraînable et le moteur d’entraînement local. Un modèle ONNX permet déjà le suivi et la comparaison des réglages. Aucun abonnement ni calcul distant." Foreground="#BFFFFFFF"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="ImportTrainingButton" Content="Importer les poids source (.pt)" Click="ImportTraining_Click"/>
                        <Button x:Name="StartTrainingButton" Content="Entraîner et comparer localement" Click="StartTraining_Click"/>
                        <Button x:Name="CancelTrainingButton" Content="Annuler le calcul" Click="CancelTraining_Click"/>
                    </WrapPanel>
                    <TextBlock Text="Importez uniquement les poids d’une source de confiance : les fichiers PyTorch peuvent contenir du code. L’entraînement est optionnel ; l’observation et les réglages utilisent votre ONNX actuel." Foreground="#BFFFFFFF"/>
                    <TextBlock x:Name="TrainingStatusText" Foreground="#E6D8B3" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#14FFFFFF" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="ImportTitle" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ImportDetail" Foreground="#BFFFFFFF" Margin="0,5,0,8"/>
                    <TextBlock x:Name="SettingsText" FontSize="14"/>
                    <TextBlock x:Name="AdsText" Foreground="#BFFFFFFF" Margin="0,6,0,0"/>
                    <TextBlock x:Name="UnknownText" Foreground="#E6D8B3" Margin="0,8,0,0"/>
                    <StackPanel x:Name="AccountChoicePanel" Visibility="Collapsed" Margin="0,12,0,0">
                        <TextBlock Text="Plusieurs configurations : sélectionnez le bon ensemble de réglages, sans rien retaper."/>
                        <ComboBox x:Name="AccountChoices" DisplayMemberPath="Label" Margin="0,8,0,8"/>
                        <Button x:Name="SelectAccountButton" Content="Utiliser ces réglages" Click="SelectAccount_Click" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="RefreshSettingsButton" Content="Relire les réglages R6" Click="RefreshSettings_Click"/>
                        <Button Content="Ouvrir les modèles" Click="OpenModels_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="ActionMessage" Foreground="#E6D8B3"/>
                </StackPanel>
            </Border>
            <Border Background="#14FFFFFF" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Lecture du HUD en direct · expérimental" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LiveStatusText" Margin="0,6,0,0"/>
                    <TextBlock x:Name="LiveValuesText" Margin="0,6,0,0"/>
                    <TextBlock x:Name="LiveDetailText" Foreground="#BFFFFFFF" Margin="0,6,0,0"/>
                    <TextBlock Text="DPI : pas lisible dans le jeu. Arme/lunette sous forme d’icônes et état ADS : reconnaissance à développer et valider." Foreground="#E6D8B3" Margin="0,6,0,0"/>
                    <TextBlock Text="Pour préparer cette reconnaissance : ce bouton sauvegarde 20 paires d’images du jeu sur ce PC. Rien n’est envoyé automatiquement." Foreground="#BFFFFFFF" Margin="0,10,0,8"/>
                    <Button x:Name="ValidationCaptureButton" Content="Collecter 20 images pour validation" Click="StartValidation_Click" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="ValidationCaptureText" Foreground="#E6D8B3"/>
                </StackPanel>
            </Border>
            <Border Background="#14FFFFFF" CornerRadius="8" Padding="14">
                <StackPanel>
                    <TextBlock Text="Rapport et prochaine étape" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ReportText" Margin="0,6,0,0"/>
                    <TextBlock x:Name="NextStepText" Foreground="#BFFFFFFF" Margin="0,6,0,10"/>
                    <WrapPanel>
                        <Button Content="Ouvrir les rapports" Click="OpenReports_Click"/>
                        <Button x:Name="LatestReportButton" Content="Afficher le dernier ZIP" Click="ShowLatestReport_Click"/>
                    </WrapPanel>
                    <TextBlock Text="Les ZIP restent sur ce PC. Aucun rapport n’est envoyé automatiquement." Foreground="#BFFFFFFF"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
